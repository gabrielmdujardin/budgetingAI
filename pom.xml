<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ─── Parent: Spring Boot 4 gerencia versões das dependências core ─── -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>dio</groupId>
    <artifactId>budgeting</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>budgeting</name>
    <description>API Financeira Inteligente — Spring Boot 4 + Spring AI + Ollama (100% local)</description>

    <properties>
        <java.version>21</java.version>
        <!-- Spring AI BOM: alinhado com Spring Boot 4 -->
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- SpringDoc: documentação automática da API REST -->
        <springdoc.version>2.8.3</springdoc.version>
    </properties>

    <!-- ─── Spring AI BOM: gerencia versões de todos os módulos spring-ai ─── -->
    <!--
        Por que BOM (Bill of Materials)?
        Garante que todos os artefatos spring-ai usem versões compatíveis
        sem precisar declarar cada versão manualmente.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ══════════════════════════════════════════════════════
             SPRING BOOT — CORE
             ══════════════════════════════════════════════════════ -->

        <!-- Web: endpoints REST (@RestController, @RequestMapping) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA: mapeamento objeto-relacional com Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Bean Validation: @NotBlank, @Positive, @Valid nos DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             SPRING AI — OLLAMA (LLM local)
             ══════════════════════════════════════════════════════ -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             BANCO DE DADOS
             ══════════════════════════════════════════════════════ -->

        <!-- MySQL Connector (runtime: só precisamos em execução, não em compilação) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             PRODUTIVIDADE
             ══════════════════════════════════════════════════════ -->

        <!--
            Lombok: elimina boilerplate de getters/setters/construtores.
            optional=true: não vaza para quem depender deste projeto.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             DOCUMENTAÇÃO — SWAGGER / OPENAPI
             ══════════════════════════════════════════════════════ -->
        <!--
            SpringDoc gera automaticamente a interface Swagger UI
            a partir das anotações @RestController e @Operation.
            URL: http://localhost:8080/swagger-ui.html
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ══════════════════════════════════════════════════════
             TESTES
             ══════════════════════════════════════════════════════ -->

        <!--
            spring-boot-starter-test inclui:
            - JUnit 5: framework de testes
            - Mockito: criação de mocks
            - AssertJ: asserções fluentes
            - Spring Test: contexto de teste
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Plugin Spring Boot: empacota o fat-jar e habilita spring-boot:run -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Exclui Lombok do jar final (só é necessário em compile-time) -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
